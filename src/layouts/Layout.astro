---
import { Font } from "astro:assets";
import "@styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Consultant and Developer",
  description = "Engineering solutions built to perform and designed to scale.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const faviconHref = import.meta.env.DEV ? "/favicon-dev.svg" : "/favicon.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="canonical" href={canonicalURL.href} />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="VISUA1HUE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@visua1hue" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Theme color -->
    <meta name="theme-color" content="#08090A" />

    <Font cssVariable="--font-inter" preload />
    <!-- Mono is only used for small labels; not worth a preload -->
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body>
    <slot />
  </body>
</html>
