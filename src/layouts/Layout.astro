---
import { Font } from "astro:assets";
import navEntryState from "@scripts/nav-entry-state.js?raw";
import "@styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results (e.g. 404). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const faviconHref = import.meta.env.DEV ? "/favicon-dev.svg" : "/favicon.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* Sets html[data-internal-nav] when opened from another page of the site (not a reload), so
        first-visit entrance animations don't replay. Also skips the page transition on back and
        forward, and restarts the fade-in of a page Chrome loaded ahead of time (both at pagereveal,
        which fires before the first paint). Inline and blocking: it must run before the first
        paint, and a file would hold that paint for a request. The CSP allows it by hash
        (INTERNAL_NAV_HASH, security-headers.ts); astro-headers.ts fails the build if they drift */}
    <script is:inline set:html={navEntryState}></script>
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    {!noindex && <link rel="canonical" href={canonicalURL.href} />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalURL.href} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="VISUA1HUE" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@visua1hue" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#FAFAF9" />

    {/* No preload: Chrome holds first paint for a preloaded font (~115ms measured) */}
    <Font cssVariable="--font-inter" />
    <slot name="head" />
    {/* Dev only: the Debugger's face */}
    {import.meta.env.DEV && <Font cssVariable="--font-geist-mono" />}
  </head>
  <body>
    <slot />
  </body>
</html>
