---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "@styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Consultant and Developer",
  description = "Engineering solutions built to perform and designed to scale.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL.href} />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="VISUA1HUE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@visua1hue" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Theme color -->
    <meta name="theme-color" content="oklch(0.794 0.018 67.565)" />

    <Font cssVariable="--font-inter" preload />

    <ClientRouter />
  </head>
  <body class="is-loading">
    <main>
      <slot />
    </main>
    <script>
      import { initAnimations } from "@scripts/animation/motion";

      // astro:page-load fires on initial load and every View Transition navigation
      document.addEventListener('astro:page-load', () => {
        initAnimations();
        // Release scroll-lock on pages that don't run their own entrance animation
        if (!document.querySelector('[data-entrance]')) {
          document.body.classList.remove('is-loading');
        }
      });

      // Metrics HUD — lazy-loaded on backtick; auto-restores if localStorage flag is set
      const _metricsKey = '__dev-metrics-visible';
      let _metricsInit = false;
      if (localStorage.getItem(_metricsKey) === 'true') {
        _metricsInit = true;
        import('@scripts/dev/metrics').then(m => m.initDevMetrics());
      }
      document.addEventListener('keydown', async (e) => {
        if (e.key === '`' && !e.metaKey && !e.ctrlKey && !e.altKey && !e.shiftKey && !_metricsInit) {
          _metricsInit = true;
          const { initDevMetrics } = await import('@scripts/dev/metrics');
          initDevMetrics();
        }
      });
    </script>
  </body>
</html>
