---
import { Font } from "astro:assets";
import navEntryState from "@/scripts/nav-entry-state.js?raw";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const faviconHref = import.meta.env.DEV ? "/favicon-dev.svg" : "/favicon.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* Inline and blocking: must run before first paint; a file would hold paint for a request.
        CSP allows it by a hash security-headers.ts derives from the file */}
    <script is:inline set:html={navEntryState}></script>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    {!noindex && <link rel="canonical" href={canonicalURL.href} />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalURL.href} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="VISUA1HUE" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@visua1hue" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* --neutral-98 as hex */}
    <meta name="theme-color" content="#FAFAF9" />

    {/* No preload: Chrome holds first paint for a preloaded font (~115ms measured) */}
    <Font cssVariable="--font-inter" />
    <slot name="head" />
    {/* Debugger.astro font */}
    {import.meta.env.DEV && <Font cssVariable="--font-geist-mono" />}
  </head>
  <body>
    <slot />
  </body>
</html>
