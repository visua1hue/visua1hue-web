---
// Render only behind import.meta.env.DEV
import type { DevMetrics } from "@/dev/dev-metrics";

const cells: { label: string; key: keyof DevMetrics; initial: string; unit: string }[] = [
  { label: "FPS", key: "fps", initial: "—", unit: "" },
  { label: "FCP", key: "fcp", initial: "—", unit: "ms" },
  { label: "LCP", key: "lcp", initial: "—", unit: "ms" },
  { label: "INP", key: "inp", initial: "—", unit: "ms" },
  { label: "CLS", key: "cls", initial: "0.000", unit: "" },
  { label: "MEM", key: "mem", initial: "—", unit: "MB" },
  { label: "DELAY", key: "delay", initial: "—", unit: "ms" },
  { label: "JANK", key: "jank", initial: "—", unit: "%" },
  { label: "NET", key: "net", initial: "—", unit: "" },
  { label: "CSS", key: "css", initial: "—", unit: "" },
];
---

<button type="button" class="debugger" data-debugger hidden>
  {
    cells.map((c) => (
      <span class="cell">
        <span class="l">{c.label}</span>
        <span class="n" data-m={c.key}>{c.initial}</span>
        <span class="u">{c.unit}</span>
      </span>
    ))
  }
</button>

<style>
  .debugger {
    display: flex;
    flex-direction: column;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    user-select: none;
    margin: -4px -6px;
    padding: 4px 6px;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    cursor: default;
  }

  .debugger[hidden] {
    display: none;
  }

  .cell {
    display: grid;
    grid-template-columns: 6ch 5ch 2ch;
    align-items: baseline;
    column-gap: 1ch;
    line-height: 1.8;
  }

  .n {
    text-align: right;
    color: var(--color-soft);
  }

  .l,
  .u {
    color: var(--color-subtle);
  }
</style>

<script>
  import { initDebugger } from "@/dev/debugger";

  if (import.meta.env.DEV) {
    for (const root of document.querySelectorAll<HTMLElement>("[data-debugger]")) initDebugger(root);
  }
</script>
