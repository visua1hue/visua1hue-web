---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import Logotype from "@components/Logotype.astro";
---

<Layout
  title="VISUA1HUE — Consultant and Developer"
  description="Independent Consultant and Developer. Building reliable, performant solutions."
>
  <section class="hero" data-entrance>
    <a href="/" class="logotype-link" aria-label="Home">
      <Logotype />
    </a>
    <!-- row 3 reserved for future text; columns 9/13 beside the logotype free for a corner mark -->
  </section>

  <div class="lower" id="lower"></div>
</Layout>

<style>
  :global(body) {
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    overflow-x: hidden;
  }

  :global(body.is-loading) {
    overflow: hidden;
  }

  /* No content below — prevent scroll until sections are added */
  :global(body:has(#lower:empty)) {
    overflow: hidden;
  }

  .hero {
    grid-row: 1;
    grid-column: 1;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: clamp(72px, 9vw, 132px) auto auto 1fr;
    column-gap: clamp(16px, 2.5vw, 36px);
    padding-inline: 28px;
    padding-block: clamp(28px, 4vw, 56px);
    min-block-size: clamp(460px, 38vw, 680px);
    background-color: var(--color-neutral-50);
  }

  .logotype-link {
    grid-row: 2;
    grid-column: 1 / 9;
  }

  .logotype-link:focus-visible {
    outline: none;
  }

  .lower {
    grid-row: 2;
    grid-column: 1;
    background-color: var(--color-primary-100);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transform: translateY(100%);
    will-change: transform;
    transition: transform 0.85s var(--motion-ease-entrance);
  }

  .lower.is-visible {
    transform: translateY(0);
  }

  @media (width < 900px) {
    .hero {
      column-gap: 16px;
      padding-inline: 24px;
      padding-block: clamp(24px, 6vw, 40px);
      min-block-size: clamp(360px, 60vw, 460px);
    }

    .logotype-link {
      grid-column: 1 / 13;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lower {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { runEntrance } from "@scripts/animation/entrance";

  // force full reload so entrance animation replays on logo click
  document
    .querySelector<HTMLAnchorElement>(".logotype-link")
    ?.addEventListener("click", (e) => {
      e.preventDefault();
      window.location.reload();
    });

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.body.classList.remove("is-loading");
  } else {
    runEntrance();
  }
</script>
