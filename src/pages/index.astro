---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import PageFrame from "@/components/PageFrame.astro";
import { Content } from "@/content/about.md";
import { POSITION } from "@/content/position";
---

<Layout
  title="About – VISUA1HUE"
  description={`${POSITION.title} at ${POSITION.org}. Curious by default: what I build, what I learn and what I'm curious about.`}
>
  <PageFrame current="about">
    {/* TODO before launch: remove the lorem in about.md (scroll test) */}
    <section class="about" aria-labelledby="about-title">
      <h1 class="page-title" id="about-title">About</h1>
      <Content />
    </section>
  </PageFrame>
</Layout>

<style>
  .about {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 0.9em;
    font-size: var(--text-lg);
    line-height: 1.32;
    letter-spacing: -0.028em;
    color: var(--color-subtle);
  }

  .about :global(p) {
    margin: 0;
  }

  .about :global(strong) {
    font-weight: var(--weight-medium);
    color: var(--color-fg);
  }
</style>
