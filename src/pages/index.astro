---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import About from "@components/About.astro";
import Footer from "@components/Footer.astro";
---

<Layout
  title="VISUA1HUE"
  description="Technical Consultant – Innovation at Centric Software. Curious by default: what I build, what I learn and what I'm curious about."
>
  <main>
    <Hero />
    <About />
  </main>
  <Footer />
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* 5 empty grid rows above the hero */
    padding-top: 120px;
  }
</style>
