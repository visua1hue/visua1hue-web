---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import PageFrame from "@/components/PageFrame.astro";
import { Content as Short } from "@/content/about.md";
import { Content as Extended } from "@/content/about-extended.md";
import { POSITION } from "@/content/position";
---

<Layout
  title="About – VISUA1HUE"
  description={`${POSITION.title} at ${POSITION.org}. Curious by default: what I build, what I learn and what I'm curious about.`}
>
  <PageFrame current="about">
    <section class="about" aria-labelledby="about-title">
      <header class="page-head">
        <h1 class="page-title" id="about-title">
          About
        </h1>
        <div class="length" role="group" aria-label="Text version">
          <button type="button" data-version="short" aria-pressed="true">
            Short
          </button>
          <span aria-hidden="true">/</span>
          <button type="button" data-version="extended" aria-pressed="false">
            Extended
          </button>
        </div>
      </header>
      <div class="text" data-text="short">
        <Short />
      </div>
      <div class="text" data-text="extended" hidden>
        <Extended />
      </div>
    </section>
  </PageFrame>
</Layout>

<style>
  .about {
    max-width: 880px;
    font-size: var(--text-lg);
    line-height: 1.32;
    letter-spacing: -0.028em;
    color: var(--color-text-subtle);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.9em;
  }

  @media (max-width: 767px) and (max-height: 700px) {
    .text {
      gap: 0.7em;
    }
  }

  .about :global(p) {
    margin: 0;
  }

  .about :global(strong) {
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  /* 44px rows pulled back to the line: the baseline stays where privacy's "Last updated" sits */
  .length {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block: calc((1.5em - var(--hit-target)) / 2);
  }

  /* Separator: not text to select */
  .length span {
    user-select: none;
  }

  /* Same box as .nav a: 44px tall, press fill inset 6px; 8px wider than the word, clear of the slash */
  .length button {
    position: relative;
    min-height: var(--hit-target);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
    transition: color var(--dur-base) var(--ease-standard);
  }

  .length button::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 6px -8px;
    border-radius: 12px;
    background: color-mix(in oklab, var(--color-fill) 50%, transparent);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-standard);
  }

  .length button[aria-pressed="true"],
  .length button:active {
    color: var(--color-text);
  }

  /* No ring after a tap or click; keyboard focus underlines like .ext links */
  .length button:focus {
    outline: none;
  }

  .length button:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (hover: hover) {
    .length button:hover {
      color: var(--color-text);
    }
  }

  /* Same press as the nav (PageFrame.astro) */
  @media (max-width: 767px) {
    .length button[data-pressed] {
      color: var(--color-text);
      transition-duration: var(--dur-fast);
    }

    .length button[data-pressed]::before {
      opacity: 1;
      transition-duration: var(--dur-fast);
    }
  }
</style>

<script>
  import { tapFeedback } from "@/scripts/lib/tap-feedback";

  const texts = [...document.querySelectorAll<HTMLElement>("[data-text]")];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-version]")];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  let current = "short";
  let latest: ViewTransition | null = null;

  const show = (version: string) => {
    current = version;
    for (const t of texts) t.hidden = t.dataset.text !== version;
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.version === version));
  };

  /** The page change's cross-fade (page-transitions.css). */
  const swap = (version: string) => {
    if (reduce.matches || !document.startViewTransition) {
      show(version);
      return;
    }
    const root = document.documentElement;
    root.dataset.textSwap = "";
    const transition = document.startViewTransition(() => show(version));
    latest = transition;
    // A quick second click skips this one; the newer transition still needs the attribute
    void transition.finished.finally(() => {
      if (latest === transition) delete root.dataset.textSwap;
    });
  };

  for (const button of buttons) {
    tapFeedback(button);
    button.addEventListener("click", () => {
      const version = button.dataset.version;
      if (version && version !== current) swap(version);
    });
  }
</script>
