---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import Logotype from "@components/Logotype.astro";
import RoleLine from "@components/RoleLine.astro";
import BuildBadge from "@components/BuildBadge.astro";
import DebugToggle from "@components/DebugToggle.astro";
import About from "@components/About.astro";
import Footer from "@components/Footer.astro";
---

<Layout
  title="VISUA1HUE"
  description="Technical Consultant – Innovation at Centric Software. Curious by default: what I build, what I learn and what I'm curious about."
>
  <main class="page-main">
    <Hero>
      <BuildBadge />
      <DebugToggle />
      <Logotype />
      <RoleLine />
    </Hero>
    <About />
  </main>
  <Footer />
</Layout>

