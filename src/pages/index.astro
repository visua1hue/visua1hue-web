---
export const prerender = true;
import Layout from "@layouts/Layout.astro";

const brand = "VISUA1HUE";
const letters = brand.split("");
---

<Layout title="Consultant and Developer – Reliable by Design">
  <div class="grid">
    <div class="container">
      <h1 class="header" aria-label={brand}>
        {letters.map((char, i) => (
          <span
            aria-hidden="true"
            class="letter"
            data-motion="outline-fill"
            data-motion-delay={`${(i * 0.07).toFixed(2)}`}
          >
            {char}
          </span>
        ))}
      </h1>
      <p
        class="subheader"
        data-motion="fade-down"
        data-motion-delay="0.8"
      >
        Built to perform. Designed to scale. <br />Focused on what matters most.
      </p>
    </div>
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    min-height: 100vh;
    align-items: center;
    justify-items: center;
    background-color: var(--color-bg-body);
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
      padding: var(--spacing-md);
    }
  }

  @media (min-width: 769px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
      padding: var(--spacing-xl);
    }
  }

  .container {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .header {
    font-size: 5rem;
    text-align: center;
    line-height: 1;
    margin: 0;
    color: var(--color-text-highlight);
  }

  .letter {
    display: inline-block;
    transform-origin: 50% 100%;
    will-change: transform, opacity, filter;
  }

  .subheader {
    font-size: var(--font-size-xl);
    text-align: center;
    line-height: var(--line-height-base);
    margin-top: var(--spacing-md);
    width: 100%;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .header {
      font-size: 3rem;
    }

    .subheader {
      font-size: var(--font-size-md);
    }
  }
</style>
