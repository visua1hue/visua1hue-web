---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
---

{/* Standalone, outside the page router */}
<Layout title="404 Not Found" description="Nothing lives at this address." noindex>
  <div class="nf">
    <header class="head">
      <nav class="nav" aria-label="Main">
        <a href="/">About</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </header>

    <main class="main">
      <h1 class="page-title">Page not found</h1>
      <p class="lead">
        This page dissolved before anyone wrote it. <strong>Nothing lives here, maybe nothing ever did.</strong>
      </p>
      <p class="back"><a href="/">Back to About</a></p>
    </main>

    <aside class="side">
      <dl class="meta">
        <div>
          <dt>Status</dt>
          <dd class="value">404 Not Found</dd>
        </div>
        <div>
          <dt>Requested</dt>
          <dd><code data-path>this address</code></dd>
        </div>
      </dl>
    </aside>
  </div>
</Layout>

<style>
  /* One viewport tall, never more (body's 100vh outgrows the visible area on phones) */
  :global(body) {
    min-height: 100dvh;
  }

  .nf {
    --pad-top: clamp(24px, 4vw, 36px);
    --below-nav: calc(var(--hit-target) + clamp(48px, 7vw, 88px));
    flex: 1;
    width: 100%;
    padding: var(--pad-top) var(--page-edge) clamp(40px, 7vh, 80px);
    display: grid;
    grid-template-columns: minmax(200px, 300px) minmax(0, 1fr);
    grid-template-areas:
      "head ."
      "side main";
    column-gap: clamp(40px, 6vw, 96px);
    align-content: start;
    font-size: var(--text-sm);
    line-height: 1.5;
    letter-spacing: -0.011em;
  }

  .head {
    grid-area: head;
  }

  .nav {
    display: flex;
    gap: 28px;
  }

  .nav a {
    min-height: var(--hit-target);
    display: inline-flex;
    align-items: center;
    color: var(--color-subtle);
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: var(--color-fg);
  }

  .main,
  .side {
    padding-top: calc(var(--below-nav) - var(--hit-target));
  }

  .main {
    grid-area: main;
    min-width: 0;
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 0.9em;
  }

  .lead {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.32;
    letter-spacing: -0.028em;
    color: var(--color-subtle);
  }

  .lead strong {
    font-weight: var(--weight-medium);
    color: var(--color-fg);
  }

  .back {
    margin: 0;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-target);
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-faint);
    transition: text-decoration-color 0.2s ease;
  }

  .back a:hover,
  .back a:focus-visible {
    text-decoration-color: currentColor;
  }

  .side {
    grid-area: side;
    min-width: 0;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .meta dt {
    color: var(--color-subtle);
  }

  .meta dd {
    margin: 0;
    min-width: 0;
  }

  .value {
    font-weight: var(--weight-bold);
    color: var(--color-fg);
  }

  code {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-fg);
  }

  /* As PageFrame. A cover fades off the text so it stays the LCP */
  @media (prefers-reduced-motion: no-preference) {
    .head,
    .side {
      animation: fade-in var(--enter-dur) var(--enter-ease) both;
    }

    .main {
      position: relative;
    }

    .main::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--color-bg);
      pointer-events: none;
      animation: cover-off var(--enter-dur) var(--enter-ease) both var(--cascade-delay);
    }
  }

  @media (max-width: 767px) {
    .nf {
      --below-nav: calc(var(--hit-target) + 32px);
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "head"
        "main"
        "side";
      row-gap: 0;
    }

    .side {
      padding-top: 48px;
    }
  }
</style>

<script>
  // Static page: show the requested path. textContent, never HTML
  document.querySelectorAll<HTMLElement>("[data-path]").forEach((el) => {
    let path = location.pathname;
    try {
      path = decodeURIComponent(path);
    } catch {
      /* malformed escape: show it raw */
    }
    el.textContent = path;
    el.title = path;
  });
</script>
