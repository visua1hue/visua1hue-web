---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import PageFrame from "@/components/PageFrame.astro";
import { Content } from "@/content/privacy.md";
---

<Layout title="Privacy – VISUA1HUE" description="What this site does and doesn't do with your data." noindex>
  <PageFrame current="privacy">
    <article class="policy" aria-labelledby="privacy-title">
      <header class="policy-head">
        <h1 class="page-title" id="privacy-title">Privacy Policy</h1>
        <p class="updated">Last updated: <time datetime="2026-11-15">15 November 2026</time></p>
      </header>
      {/* TODO before launch: "No cookies" holds only while no Cloudflare bot feature sets one (Security → Bots) */}
      <Content />
    </article>
  </PageFrame>
</Layout>

<style>
  .policy {
    max-width: 680px;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    letter-spacing: -0.012em;
  }

  .policy-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 24px;
    margin-bottom: 24px;
  }

  .policy-head + :global(p) {
    font-size: var(--text-lg);
    line-height: 1.32;
    letter-spacing: -0.028em;
    color: var(--color-subtle);
  }

  .policy :global(h2) {
    margin: 48px 0 10px;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-fg);
  }

  .policy :global(p) {
    margin: 0;
  }

  .policy :global(address) {
    font-style: normal;
  }

  .updated {
    color: var(--color-subtle);
  }

  /* Not ::marker: width varies by font */
  .policy :global(ul) {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .policy :global(li) {
    position: relative;
    padding-left: 1.25em;
  }

  .policy :global(li)::before {
    content: "–" / "";
    position: absolute;
    left: 0;
    color: var(--color-subtle);
  }

  .policy :global(li + li) {
    margin-top: 6px;
  }

  .policy :global(strong) {
    font-weight: var(--weight-medium);
    color: var(--color-fg);
  }

  .policy :global(p a),
  .policy :global(li a) {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
</style>
