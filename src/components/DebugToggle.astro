---
import type { HeroPart } from "@scripts/lib/hero-parts";

const cells = [
  { label: "FCP", key: "fcp", initial: "—", unit: "ms" },
  { label: "LCP", key: "lcp", initial: "—", unit: "ms" },
  { label: "INP", key: "inp", initial: "—", unit: "ms" },
  { label: "CLS", key: "cls", initial: "0.000", unit: "" },
  { label: "FPS", key: "fps", initial: "—", unit: "" },
] as const;
---

<div class="debug" data-debug>
  <button
    class="grid-cell toggle"
    type="button"
    aria-pressed="true"
    data-debug-toggle
    data-hero={"debug" satisfies HeroPart}><span class="dim">Debug:</span><span class="v" data-debug-value>True</span></button
  >
  <div class="panel" aria-hidden="true" data-debug-panel>
    {
      cells.map((c) => (
        <div class="grid-cell metric" data-hero={"metric" satisfies HeroPart}>
          <span class="dim">{c.label}</span>
          <span class="v">
            <span class="n" data-m={c.key}>{c.initial}</span>
            <span class="u">{c.unit}</span>
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* Scoping root for the script; no box, so it doesn't affect the hero layout */
  .debug {
    display: contents;
  }

  /* Button reset on top of .grid-cell */
  .toggle {
    appearance: none;
    margin: 0;
    border: 0;
    padding: 0 0 0 10px;
    font-weight: inherit;
    line-height: inherit;
    text-align: inherit;
    color: var(--color-subtle);
    cursor: pointer;
    /* Pre-layout position: meta row, right-aligned */
    top: var(--grid-meta-row);
    right: var(--grid-meta-inset);
  }

  .toggle .dim {
    width: 7.5ch;
    display: inline-block;
  }

  .toggle .v {
    color: var(--color-muted);
    width: 5ch;
    text-align: left;
    margin-left: 1px;
  }

  .toggle:hover .v,
  .toggle:focus-visible .v,
  .toggle[aria-pressed="true"] .v {
    color: var(--color-fg);
  }

  .toggle:focus-visible {
    outline: 1px solid var(--color-subtle);
    outline-offset: -1px;
  }

  .panel {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .metric {
    font-variant-numeric: tabular-nums;
  }

  /* Pre-layout positions: one row left of DEBUG, from column 2, a gap square between blocks */
  .metric {
    --i: 0;
    top: var(--grid-meta-row);
    left: calc(var(--grid-meta-inset) + (1 + var(--i) * (var(--grid-block-span) + 1)) * var(--grid-size));
  }

  .metric:nth-child(2) {
    --i: 1;
  }

  .metric:nth-child(3) {
    --i: 2;
  }

  .metric:nth-child(4) {
    --i: 3;
  }

  .metric:nth-child(5) {
    --i: 4;
  }

  .metric .dim {
    width: 5ch;
    display: inline-block;
  }

  .metric .v {
    display: inline-flex;
    color: var(--color-soft);
    animation: flick 2.6s steps(1, end) infinite;
  }

  .metric .n {
    width: 5ch;
    text-align: right;
  }

  .metric .u {
    width: 3ch;
    padding-left: 1ch;
  }

  .metric:nth-child(2) .v {
    animation-delay: -0.7s;
  }

  .metric:nth-child(3) .v {
    animation-delay: -1.3s;
  }

  .metric:nth-child(4) .v {
    animation-delay: -1.9s;
  }

  .metric:nth-child(5) .v {
    animation-delay: -2.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .metric .v {
      animation: none;
    }
  }
</style>

<script>
  import { initDebugToggle } from "@scripts/DebugToggle";

  document.querySelectorAll<HTMLElement>("[data-debug]").forEach((root) => initDebugToggle(root));
</script>
