---
// Render inside .frame: the markers are positioned against it
---

<div class="back-to-top-mark" data-back-to-top-mark aria-hidden="true"></div>
<div class="back-to-top-end" data-back-to-top-end aria-hidden="true"></div>
<button type="button" class="back-to-top" data-back-to-top aria-label="Back to top">
  <span class="face">
    {/* viewBox 16 shown at 21: a 1.2 stroke renders about 1.6px */}
    <svg
      width="21"
      height="21"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path class="bar" d="M4 3H12"></path>
      <path class="arrow" d="M8 13.5V6.5M5 9.5L8 6.5L11 9.5"></path>
    </svg>
  </span>
</button>

<style>
  .back-to-top-mark {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 50vh;
    pointer-events: none;
  }

  .back-to-top-end {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .back-to-top {
    display: none;
  }

  @media (max-width: 767px) {
    .back-to-top {
      position: fixed;
      z-index: 4;
      /* 34px: level with iOS Safari's toolbar buttons */
      right: 32px;
      bottom: calc(28px + env(safe-area-inset-bottom, 0px));
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--color-text-subtle);
      cursor: pointer;
      touch-action: manipulation;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--dur-fast) var(--ease-standard),
        transform var(--dur-fast) var(--ease-standard),
        visibility var(--dur-fast);
    }

    /* Hit area 64px: 48px missed edge taps */
    .back-to-top::before {
      content: "";
      position: absolute;
      inset: -8px;
    }

    .back-to-top[data-shown] {
      opacity: 1;
      visibility: visible;
      transition-duration: var(--dur-base);
      transition-timing-function: var(--ease-out);
    }

    .face {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--color-border);
      border-radius: 32%;
      background-color: color-mix(in oklab, var(--color-bg) 70%, transparent);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      transition:
        background-color var(--dur-base) var(--ease-standard),
        color var(--dur-base) var(--ease-standard);
    }

    @supports (corner-shape: squircle) {
      .face {
        border-radius: 50%;
        corner-shape: squircle;
      }
    }

    svg {
      display: block;
      overflow: visible;
    }

    .bar {
      transform-box: fill-box;
      transform-origin: center;
    }

    /* Same press as the nav (PageFrame.astro): fill 50% over the page, no scale */
    .back-to-top[data-pressed] .face {
      background-color: color-mix(in oklab, var(--color-fill) 50%, var(--color-bg));
      color: var(--color-text);
      transition-duration: var(--dur-fast);
    }

    .back-to-top:focus-visible {
      outline: none;
    }

    .back-to-top:focus-visible .face {
      outline: 2px solid var(--color-text);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: no-preference) {
      .back-to-top:not([data-shown]) {
        transform: translateY(8px);
      }

      .back-to-top[data-at-end] .arrow {
        animation: arrow-rise 2.4s infinite;
      }

      .back-to-top[data-pressed] .arrow {
        animation-play-state: paused;
      }
    }
  }

  @keyframes arrow-rise {
    0% {
      transform: none;
      animation-timing-function: var(--ease-out);
    }

    22% {
      transform: translateY(-2.5px);
    }

    30% {
      transform: translateY(-2.5px);
      animation-timing-function: var(--ease-soft);
    }

    55%,
    100% {
      transform: none;
    }
  }
</style>

<script>
  import { scrollToTop } from "@/scripts/lib/scroll-to-top";
  import { tapFeedback } from "@/scripts/lib/tap-feedback";

  /** In viewBox units */
  const RISE = "-3.5px";
  /** Touch moving further is a scroll, not a tap */
  const SLOP_PX = 10;
  /** Window for the click iOS sends after a touch tap already handled */
  const CLICK_AFTER_TAP_MS = 600;

  const button = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
  const mark = document.querySelector("[data-back-to-top-mark]");
  const end = document.querySelector("[data-back-to-top-end]");
  const arrow = button?.querySelector<SVGPathElement>(".arrow");
  const bar = button?.querySelector<SVGPathElement>(".bar");

  function dock() {
    if (!arrow || !bar || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const css = getComputedStyle(document.documentElement);
    // The CSS minifier writes 620ms as .62s
    const dur = css.getPropertyValue("--dock-dur").trim();
    const duration = Number.parseFloat(dur) * (dur.endsWith("ms") ? 1 : 1000);
    for (const a of [...arrow.getAnimations(), ...bar.getAnimations()]) a.cancel();
    arrow.animate(
      [
        { transform: "none" },
        { transform: `translateY(${RISE})`, offset: 0.35 },
        { transform: `translateY(${RISE})`, offset: 0.55 },
        { transform: "none" },
      ],
      { duration, easing: css.getPropertyValue("--ease-out").trim() },
    );
    bar.animate(
      [
        { transform: "none" },
        { transform: "none", offset: 0.3 },
        { transform: "scaleX(1.25)", offset: 0.4 },
        { transform: "none" },
      ],
      { duration, easing: css.getPropertyValue("--ease-standard").trim() },
    );
  }

  if (button && mark) {
    new IntersectionObserver(([e]) => button.toggleAttribute("data-shown", !(e?.isIntersecting ?? true))).observe(mark);
    if (end) {
      new IntersectionObserver(([e]) => button.toggleAttribute("data-at-end", e?.isIntersecting ?? false)).observe(end);
    }

    tapFeedback(button);

    const activate = (keyboard: boolean) => {
      dock();
      scrollToTop();
      // The button hides at the top, so focus the nav
      if (keyboard) document.querySelector<HTMLElement>(".nav a")?.focus({ preventScroll: true });
    };

    // iOS drops the click when a tap stops momentum scroll: act on touch release
    let touchStart: { x: number; y: number } | null = null;
    let tappedAt = Number.NEGATIVE_INFINITY;
    button.addEventListener("pointerdown", (e) => {
      touchStart = e.pointerType === "touch" ? { x: e.clientX, y: e.clientY } : null;
    });
    button.addEventListener("pointercancel", () => (touchStart = null));
    button.addEventListener("pointerup", (e) => {
      if (!touchStart) return;
      const moved = Math.hypot(e.clientX - touchStart.x, e.clientY - touchStart.y);
      touchStart = null;
      if (moved > SLOP_PX) return;
      tappedAt = e.timeStamp;
      activate(false);
    });
    button.addEventListener("click", (e) => {
      if (e.timeStamp - tappedAt < CLICK_AFTER_TAP_MS) return;
      activate(e.detail === 0);
    });
  }
</script>
