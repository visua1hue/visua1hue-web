<style>
  .logotype {
    margin: 0;
    width: min(860px, 78vw);
    position: relative;
    z-index: 3;
    aspect-ratio: 1787.5 / 250;
  }

  .mark,
  .slice {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .defs {
    position: absolute;
  }

  .mark {
    animation: rise 1.4s var(--ease-out) both 0.25s;
  }

  .slice {
    visibility: hidden;
    clip-path: inset(var(--t, 40%) 0 var(--b, 50%) 0);
    transform: translateX(var(--x, 0));
  }

  .slice.on {
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .mark {
      animation: none;
    }
  }
</style>
