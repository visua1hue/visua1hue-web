  <svg viewBox="346.5 747 1787.5 254" preserveAspectRatio="xMidYMax meet">
    <defs>
      {/* Glyph space: one fade across the word, not per letter */}
      <linearGradient id="logotype-fade" gradientUnits="userSpaceOnUse" x1="0" y1="362" x2="0" y2="611">
        <stop offset="0"></stop>
        <stop offset="1"></stop>
      </linearGradient>
    </defs>
    <g class="glyphs" transform="translate(-99.276 388.925)">
        <path d="M538.1,606.924l44,0l90.667,-243.667l-44.333,0l-52.667,140.333c-4.667,12.333 -9.667,27.333 -15.667,48.667c-5.333,-19.667 -10,-34 -15.333,-48.667l-53.333,-140.333l-45.333,0l92,243.667Z"></path>
        <path d="M703.1,362.258l42.667,0l0,243.667l-42.667,0Z"></path>
        <path d="M785.767,431.258c0,37.333 21.667,61 63,70l38.667,8.667c20,4.333 28.333,14 28.333,30.333c0,20.333 -18,32.667 -46.333,32.667c-27.333,0 -44,-12.333 -44.333,-33l-42.667,0c1,43.667 35,71.333 87,71.333c53.667,0 89,-29.333 89,-74.667c0,-36.333 -20.333,-57.667 -62,-66.667l-38.333,-8.333c-20.333,-4.667 -29.667,-14.333 -29.667,-31.667c0,-20.333 17,-33 43.333,-33c24,0 39,12.333 40,33.333l42.667,0c-1.333,-44 -32.667,-71.333 -82,-71.333c-51.333,0 -86.667,29.667 -86.667,72.333Z"></path>
