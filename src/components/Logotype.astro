        <path d="M1836.1,517.924c0,57.333 37.333,93 96.333,93c59.333,0 96.667,-36 96.667,-93l0,-154.667l-42.667,0l0,152c0,34.667 -19.333,54.333 -54,54.333c-34.667,0 -53.667,-19.333 -53.667,-54.333l0,-152l-42.667,0l0,154.667Z"></path>
        <path d="M2232.767,606.924l0,-39.333l-108.667,0l0,-64.667l97.333,0l0,-37.667l-97.333,0l0,-62.667l108.667,0l0,-39.333l-151.333,0l0,243.667l151.333,0Z"></path>
    </g>
  </svg>
</div>

<style>
  .logotype {
    position: fixed;
    z-index: 3;
    left: var(--page-edge);
    right: var(--page-edge);
    bottom: calc(var(--logotype-h) * -0.2);
    pointer-events: none;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .glyphs {
    fill: url(#logotype-fade);
  }

  stop {
    stop-color: var(--color-logotype);
  }

  stop:last-child {
    stop-opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logotype:not(.entered) svg {
      animation: logotype-in 1.2s var(--ease-out) both paused;
    }

    .logotype.play:not(.entered) svg {
      animation-play-state: running;
    }
  }

  @media (max-width: 767px) {
    .logotype {
      position: relative;
      order: 1;
      inset: auto;
      margin: 24px var(--page-edge) 28px;
    }

    stop:first-child {
      stop-color: var(--color-faint);
    }
  }

  @keyframes logotype-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const logotype = document.querySelector<HTMLElement>(".logotype");
  if (logotype) {
    const io = new IntersectionObserver(([e]) => {
      if (!e?.isIntersecting) return;
      logotype.classList.add("play");
      io.disconnect();
    });
    io.observe(logotype);
    // Stops a replay if the node is re-inserted
    logotype.addEventListener("animationend", () => logotype.classList.add("entered"), { once: true });
  }
</script>
