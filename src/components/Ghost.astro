---
// Background logotype. Glyph paths copied from the master file src/assets/logotype.svg;
// change the logo there first
---

<div class="ghost" aria-hidden="true" transition:persist="ghost">
  <svg viewBox="346.5 747 1787.5 254" preserveAspectRatio="xMidYMax meet">
    <defs>
      {/* Glyph space (y 362..611), so the fade spans the word, not each letter */}
      <linearGradient id="ghost-fade" gradientUnits="userSpaceOnUse" x1="0" y1="362" x2="0" y2="611">
        <stop offset="0"></stop>
        <stop offset="1"></stop>
      </linearGradient>
    </defs>
    <g class="glyphs" transform="translate(-99.276 388.925)">
        <path d="M538.1,606.924l44,0l90.667,-243.667l-44.333,0l-52.667,140.333c-4.667,12.333 -9.667,27.333 -15.667,48.667c-5.333,-19.667 -10,-34 -15.333,-48.667l-53.333,-140.333l-45.333,0l92,243.667Z"></path>
        <path d="M703.1,362.258l42.667,0l0,243.667l-42.667,0Z"></path>
        <path d="M785.767,431.258c0,37.333 21.667,61 63,70l38.667,8.667c20,4.333 28.333,14 28.333,30.333c0,20.333 -18,32.667 -46.333,32.667c-27.333,0 -44,-12.333 -44.333,-33l-42.667,0c1,43.667 35,71.333 87,71.333c53.667,0 89,-29.333 89,-74.667c0,-36.333 -20.333,-57.667 -62,-66.667l-38.333,-8.333c-20.333,-4.667 -29.667,-14.333 -29.667,-31.667c0,-20.333 17,-33 43.333,-33c24,0 39,12.333 40,33.333l42.667,0c-1.333,-44 -32.667,-71.333 -82,-71.333c-51.333,0 -86.667,29.667 -86.667,72.333Z"></path>
        <path d="M995.433,517.924c0,57.333 37.333,93 96.333,93c59.333,0 96.667,-36 96.667,-93l0,-154.667l-42.667,0l0,152c0,34.667 -19.333,54.333 -54,54.333c-34.667,0 -53.667,-19.333 -53.667,-54.333l0,-152l-42.667,0l0,154.667Z"></path>
        <path d="M1251.767,606.924l19.667,-56.333l91,0l19.667,56.333l45,0l-88,-243.667l-43.667,0l-88,243.667l44.333,0Zm60,-171c2.333,-6.667 4.333,-14 5.333,-18.667c0.667,5 3,12.333 5,18.667l28,78.667l-66,0l27.667,-78.667Z"></path>
        <path d="M1495.433,401.591l0,205.333l41,0l0,-243.667l-94.333,0l0,38.333l53.333,0Z"></path>
        <path d="M1633.1,606.924l0,-103.333l108,0l0,103.333l42.667,0l0,-243.667l-42.667,0l0,100.667l-108,0l0,-100.667l-42.667,0l0,243.667l42.667,0Z"></path>
        <path d="M1836.1,517.924c0,57.333 37.333,93 96.333,93c59.333,0 96.667,-36 96.667,-93l0,-154.667l-42.667,0l0,152c0,34.667 -19.333,54.333 -54,54.333c-34.667,0 -53.667,-19.333 -53.667,-54.333l0,-152l-42.667,0l0,154.667Z"></path>
        <path d="M2232.767,606.924l0,-39.333l-108.667,0l0,-64.667l97.333,0l0,-37.667l-97.333,0l0,-62.667l108.667,0l0,-39.333l-151.333,0l0,243.667l151.333,0Z"></path>
    </g>
  </svg>
</div>

<style>
  .ghost {
    position: fixed;
    /* Over the text: the fade band in Shell.astro clears the text beneath it */
    z-index: 3;
    left: var(--page-edge);
    right: var(--page-edge);
    bottom: calc(var(--ghost-h) * -0.2);
    pointer-events: none;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    animation: ghost-in 1.8s cubic-bezier(0.22, 1, 0.36, 1) both 0.2s;
  }

  /* Tint at the cap height, gone by the baseline */
  .glyphs {
    fill: url(#ghost-fade);
  }

  stop {
    stop-color: var(--color-ghost);
  }

  stop:last-child {
    stop-opacity: 0;
  }

  .entered svg {
    animation: none;
  }

  /* Breathes gently, a hint to scroll, until the reader does (script below lets it settle) */
  .ghost {
    animation: breathe 3.6s ease-in-out 2s infinite;
  }

  .ghost.still {
    animation: none;
  }

  /* Phones: too small to pin over the text, so it closes the page as a footer mark, whole */
  @media (max-width: 767px) {
    .ghost {
      position: relative;
      order: 1;
      inset: auto;
      margin: 24px var(--page-edge) 28px;
    }

    /* Small, so the tint starts a shade deeper to stay visible */
    stop:first-child {
      stop-color: var(--color-faint);
    }
  }

  @keyframes breathe {
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes ghost-in {
    from {
      opacity: 0;
      transform: translateY(12%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ghost,
    svg {
      animation: none;
    }
  }
</style>

<script>
  // Persisted across page swaps, so this runs once
  const ghost = document.querySelector<HTMLElement>(".ghost");
  if (ghost) {
    // Play the entrance once, not again if the node is re-inserted (it ends on the svg, bubbling up)
    ghost.addEventListener(
      "animationend",
      (e) => {
        if (e.animationName.includes("ghost-in")) ghost.classList.add("entered");
      },
    );

    // First scroll: let the breathing finish its current cycle and stop at rest, instead of snapping
    const settle = () => {
      const breath = ghost.getAnimations().find((a) => a instanceof CSSAnimation && a.animationName.includes("breathe"));
      const t = breath?.effect?.getComputedTiming();
      if (!breath || !t || t.currentIteration == null) return ghost.classList.add("still");
      breath.effect?.updateTiming({ iterations: t.currentIteration + 1 });
      breath.addEventListener("finish", () => ghost.classList.add("still"), { once: true });
    };
    if (scrollY > 0) ghost.classList.add("still");
    else addEventListener("scroll", settle, { once: true, passive: true });
  }
</script>
