---
// Dev only: render it behind import.meta.env.DEV so it never reaches a production build.
// Hidden by default; backtick toggles it, click copies the values (scripts/DevHud.ts)
const cells = [
  { label: "FPS", key: "fps", initial: "—", unit: "" },
  { label: "FCP", key: "fcp", initial: "—", unit: "ms" },
  { label: "LCP", key: "lcp", initial: "—", unit: "ms" },
  { label: "INP", key: "inp", initial: "—", unit: "ms" },
  { label: "CLS", key: "cls", initial: "0.000", unit: "" },
  { label: "MEM", key: "mem", initial: "—", unit: "MB" },
  { label: "DELAY", key: "delay", initial: "—", unit: "ms" },
  { label: "JANK", key: "jank", initial: "—", unit: "%" },
  { label: "NET", key: "net", initial: "—", unit: "" },
  { label: "CSS", key: "css", initial: "—", unit: "" },
] as const;
---

<button type="button" class="hud" data-dev-hud hidden>
  {
    cells.map((c) => (
      <span class="cell">
        <span class="dim">{c.label}</span>
        <span class="n" data-m={c.key}>{c.initial}</span>
        <span class="u">{c.unit}</span>
      </span>
    ))
  }
</button>

<style>
  /* Sits in the Shell's left column, under the meta */
  .hud {
    display: flex;
    flex-direction: column;
    /* Hug the cells; as a block it stretches to the side column and the flash spans it */
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    user-select: none;
    /* Padding offset by margin: room for the copy flash without moving the text */
    margin: -4px -6px;
    padding: 4px 6px;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    cursor: default;
  }

  .hud[hidden] {
    display: none;
  }

  .cell {
    display: grid;
    grid-template-columns: 6ch 5ch 2ch;
    align-items: baseline;
    column-gap: 1ch;
    line-height: 1.8;
  }

  .n {
    text-align: right;
    color: var(--color-soft);
  }

  .u {
    color: var(--color-subtle);
  }
</style>

<script>
  import { initDevHud } from "@scripts/DevHud";

  if (import.meta.env.DEV) {
    document.querySelectorAll<HTMLElement>("[data-dev-hud]").forEach((root) => initDevHud(root));
  }
</script>
