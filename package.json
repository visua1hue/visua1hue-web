{
  "name": "visua1hue-web",
  "type": "module",
  "version": "0.0.4",
  "scripts": {
    "dev": "pkill -f 'astro dev' 2>/dev/null; lsof -ti:4321 | xargs kill -9 2>/dev/null; rm -rf .wrangler .astro && astro dev",
    "build": "astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "astro": "7.1.3",
    "astro-icon": "^1.1.5",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "14.1.4",
    "typescript": "^5.9.3",
    "wrangler": "4.98.0"
  }
}
