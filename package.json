  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/markdown-satteri": "0.4.5",
    "@cloudflare/vite-plugin": "^1.64.0",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "^5.9.3",
    "wrangler": "4.152.0"
  }
}
