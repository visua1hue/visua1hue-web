{
  "name": "visua1hue-web",
  "type": "module",
  "version": "0.0.4",
  "scripts": {
    "dev": "pkill -f 'astro dev' 2>/dev/null; lsof -ti:4321 | xargs kill -9 2>/dev/null; rm -rf .wrangler .astro && astro dev",
    "build": "astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "astro": "^6.4.4",
    "astro-icon": "^1.1.5",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^13.6.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.98.0"
  },
  "overrides": {
    "undici": "^7.24.2",
    "yauzl": "^3.2.1"
  }
}
