# astro-headers.ts appends security headers at build

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed; a day stale is fine, saves a revalidation per visit
/favicon.svg
  Cache-Control: public, max-age=86400

# Header, so the CSP needs no inline script. Per path: a second `/*` block collides with astro-headers.ts
/
  Speculation-Rules: "/speculation-rules.json"

/privacy/
  Speculation-Rules: "/speculation-rules.json"

/speculation-rules.json
  Content-Type: application/speculationrules+json

# Production only; previews keep the default so a new deploy shows on reload
https://visua1hue.dev/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

https://visua1hue.dev/privacy/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
