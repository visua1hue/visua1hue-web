# Security headers are appended at build time by integrations/security-headers.ts

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed; a day of staleness is fine and skips a revalidation per visit
/favicon.svg
  Cache-Control: public, max-age=86400

# Same-origin links are prefetched on load; header-delivered so the CSP needs no inline script.
# Per page: a second `/*` block would collide with the one integrations/security-headers.ts appends
/
  Speculation-Rules: "/speculation-rules.json"

/privacy/
  Speculation-Rules: "/speculation-rules.json"

/speculation-rules.json
  Content-Type: application/speculationrules+json

# Production HTML only: returning visitors skip the revalidation for 5 min, then refresh
# in the background. Previews keep the default so a fresh deploy shows on reload
https://visua1hue.dev/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

https://visua1hue.dev/privacy/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
